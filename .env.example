# PostgreSQL connection (local or Supabase)
# Supabase example: postgresql+psycopg://postgres:<password>@db.<project>.supabase.co:5432/postgres
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/skillswap

# JWT settings
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Default admin account created on startup
ADMIN_EMAIL=admin@skillswap.com
ADMIN_PASSWORD=Admin@123
